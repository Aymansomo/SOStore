<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!--
        Package visibility (Android 11+). PackageManager can only see the apps listed here.
        Add one <package> entry per app in AppCatalogConfig.apps.
        If you prefer the broad approach, replace this block with:
        <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    -->
    <queries>
        <package android:name="paige.navic.debug" />
        <package android:name="com.ayman.macrodeck.mobile" />
        <package android:name="com.prism.music" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_store_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyAppStore">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyAppStore">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives PackageInstaller session results. Must stay non-exported. -->
        <receiver
            android:name=".installer.InstallResultReceiver"
            android:exported="false" />

    </application>

</manifest>
